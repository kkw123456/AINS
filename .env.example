# ===== webgen 本机配置（复制成 .env 后改）=====

# 预览域名后缀（本地 *.localhost 由浏览器原生解析到回环）
PREVIEW_DOMAIN=localhost
PREVIEW_SCHEME=http
# 宿主机唯一对外的端口（Traefik 映射 8088:80）
PREVIEW_PORT=8088

# 已发布站点的域名后缀：线上地址是 <slug>.site.<SITE_DOMAIN>。
# 和预览的 p-<id> 分开，避免改 slug 时和预览/编辑容器的域名空间打架。
SITE_DOMAIN=site.localhost

# 服务端口
ORCHESTRATOR_PORT=8800
EXECUTOR_PORT=8100

# 节点注册：orchestrator 用 EXECUTOR_URLS 预置节点地址，
# executor 用 ORCHESTRATOR_URL 上报心跳，并用自己的 WEBGEN_ADVERTISE_URL 告诉对方怎么回调。
EXECUTOR_URLS=http://127.0.0.1:8100
ORCHESTRATOR_URL=http://127.0.0.1:8800
WEBGEN_ADVERTISE_URL=http://127.0.0.1:8100

# 沙箱与 Traefik 共享的 docker 网络（必须与 infra/docker-compose.yml 一致）
WEBGEN_DOCKER_NETWORK=webgen-net
# 单节点最多同时跑几个沙箱
EXECUTOR_CAPACITY=20

# 工作区根目录：**必须在 ext4 上**，不能放 /mnt/d（跨 9P 会慢一个量级）
WEBGEN_DATA_DIR=/root/webgen-data

# 沙箱
WEBGEN_NODE_ID=node-a
# 沙箱容器 publish 到宿主的端口段（跨机访问时用）
SANDBOX_PORT_RANGE_START=31000
SANDBOX_PORT_RANGE_END=31999

# MySQL（compose 内部）
# 端口用 13306 而不是 3306：本机 Windows 上已有 MySQL 占着 3306，
# 而 WSL 的 mirrored 网络与 Windows 共享端口空间（详见 docs/DESIGN.md §4.1）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=webgen_root
MYSQL_DATABASE=webgen
MYSQL_USER=webgen
MYSQL_PASSWORD=webgen_pass

# Redis（compose 内部，S4 共享缓存）。**按 key 前缀隔离**（每项目 key 前置 <id>:）；
# 队列仍然放 MySQL，Redis 只做缓存/会话。只有 webgen-net 上的沙箱按服务名 `redis` 访问它。
REDIS_PASSWORD=webgen_redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO（对象存储 / 「文件系统」，compose 内部）。共享实例，**每项目一个 bucket**（p_<id>）。
# 凭证是平台共享的，隔离是约定（各写各的 bucket），不是强制。
MINIO_ROOT_USER=webgen_minio
MINIO_ROOT_PASSWORD=webgen_minio_pass
MINIO_HOST=minio
MINIO_PORT=9000
# 镜像名可覆盖（MinIO 上游删了 latest；本机镜像站对 minio 403，拉到哪个 tag 填哪个）
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# 项目密钥加密（S4）。project_env 里的连接串用它（AES-256-GCM）加密落库。
# ⚠️ 不设的话：连接串**以明文落库**（仅限本机 dev）；生产必须设一个随机串。
WEBGEN_SECRET_KEY=

# 单项目资源上限（可在 template.json 里覆盖，但有天花板）
LIMIT_CPUS=1
LIMIT_MEMORY_MB=1024
LIMIT_BUILD_MEMORY_MB=2048
LIMIT_DISK_MB=2048
LIMIT_PIDS=256

# 项目数上限
MAX_PROJECTS=50
# ⚠️ 原来写死 5，但现在有 **5 个服务型模板**，而且 smoke 脚本自己就要同时占 3 个
#（① 建的、⑥ 的 fastapi、⑧ 的内存探针）—— 加上你手工建的几个就必然撞上限，
# 表现为"某个项目建不出来"，很难一眼看出是限额。12 是给开发机的合理天花板。
MAX_SERVICE_PROJECTS=12

# ===== 生成引擎（S1）=====
# claude 的接入方式。本机是"claude 走本地代理"（见 docs/DESIGN.md §4.1）：
# 代理管真实凭据，客户端只需要把 BASE_URL 指过去、随便给个 token。
# 生产上换成真实凭据（或镜像里登录好的 claude），这两项就别设了。
ANTHROPIC_BASE_URL=http://127.0.0.1:15721
ANTHROPIC_AUTH_TOKEN=PROXY_MANAGED

# claude 拒绝以 root 运行；WSL/容器里默认就是 root，必须显式声明自己在沙箱里。
# 正确的做法是让服务以非 root 用户跑，这条是开发期的让步。
IS_SANDBOX=1

# 留空则用 claude 自己的默认模型
# WEBGEN_AGENT_MODEL=
# 单轮最多几个 SDK 回合。**0 = 不限**（默认）。
# 以前写死 60，一大轮生成会被掐断报「Reached maximum number of turns」，
# 交付的是半成品；真正的兜底是 AGENT_VERIFY_TIMEOUT_MS + AGENT_MAX_REPAIR_ROUNDS。
WEBGEN_AGENT_MAX_TURNS=0

# 一轮生成里最多几次「改 → 验证 → 修」
AGENT_MAX_REPAIR_ROUNDS=3
# 每次验证等应用起来的上限（毫秒）
AGENT_VERIFY_TIMEOUT_MS=120000
