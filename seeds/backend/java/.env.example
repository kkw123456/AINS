# 监听端口（**不是** PORT —— 那是 nginx 的 8080）。application.yml 里 `server.port: ${APP_PORT:3001}`
APP_PORT=3001

# 数据层：平台选了才会注入。有值 → 文件存储，落 ${WEBGEN_DATA_DIR}/visits.txt（storage="file"）
#          没值 → 内存态，重启归零（storage="memory"）
WEBGEN_DATA_DIR=

# 说明：本模板依赖固定为 Spring Boot Web/Validation/Actuator/Test 四个 starter，
# 没有 MySQL / Redis 驱动，所以下面这两个**当前不生效**，先留着对齐 node/python 的 .env：
#   DATABASE_URL   形如 mysql://user:pass@host:3306/db
#   REDIS_URL      Redis DSN（配了才 cache=redis，现在恒为 null）
DATABASE_URL=
REDIS_URL=
