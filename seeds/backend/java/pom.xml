<?xml version="1.0" encoding="UTF-8"?>
<!--
  组合出来的项目里的 **Java 后端**（Spring Boot）。

  ⚠️ 依赖必须和 `sandbox/images/java/warm/pom.xml` **逐条一致** —— 镜像里预热的 /opt/m2
  是按那份拉的。这边多一个依赖，沙箱里第一次构建就会联网、撞 verify 超时（实测会卡死），
  所以**一个包都不许加**；要加就得同步改 warm 那份并重建镜像。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.webgen</groupId>
  <artifactId>app</artifactId>
  <version>1.0.0</version>
  <name>app</name>
  <description>webgen 组合项目的 Java 后端（Spring Boot 企业级骨架）</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- ★ 只这四样。别再往下加 —— 镜像 /opt/m2 就是照这四样预热的。 -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- 固定成 target/app.jar，启动命令就能写死 `java -jar target/app.jar` -->
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
