# ─────────────────────────────────────────────────────────────
# webgen Node 后端（组合项目）示例环境变量。
# 复制成 .env 后按需取消注释即可。**启动时读一次并校验（zod）**，坏值直接报错退出。
# ─────────────────────────────────────────────────────────────

# 后端监听端口。**这是容器内的内部端口**（默认 3001）。
# ⚠️ 对外那个口归 nginx（组合项目里是 8080），后端听的是 APP_PORT —— 别写成 PORT。
APP_PORT=3001

# 结构化日志级别：fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── 存储选择（启动时决定，三选一；优先级：DATABASE_URL > WEBGEN_DATA_DIR > 内存）──

# SQLite：给它一个目录，就会在 <目录>/app.db 建库（Node 22 内置 node:sqlite，无外部依赖）。
# 组合项目里平台注入的是 /workspace/data（bind mount 到宿主，容器重建后仍在）。
# WEBGEN_DATA_DIR=/workspace/data

# MySQL：给连接串就选 MySQL（与 sqlite 互斥，且优先级更高）。
# DATABASE_URL=mysql://user:pass@host:3306/dbname

# ── 缓存（可选）──
# 配了 REDIS_URL 则 cache="redis"，否则 cache=null。
# REDIS_URL=redis://127.0.0.1:6379/0
# 所有 key 统一加这个前缀（多项目共用一个 Redis 实例时用来隔离）。
# REDIS_KEY_PREFIX=

# ── 对象存储（「文件系统」，可选）──
# S3 兼容（共享 MinIO 实例，**每项目一个 bucket**，形如 p-<projectId>；连字符，非下划线）。
# 平台按项目注入；**没配 S3_ENDPOINT 就是不接对象存储**，/api/files 会返回
# storage="none"（优雅降级，不报错）。四个变量要么都配、要么都不配 ——
# 只配 S3_ENDPOINT 而缺 key/bucket 属于坏配置，启动期就会报错退出。
# S3_ENDPOINT=http://minio:9000     # 容器内按服务名访问
# S3_ACCESS_KEY=webgen_minio
# S3_SECRET_KEY=webgen_minio_pass
# S3_BUCKET=p-<projectId>            # 平台按项目注入，种子直接用，不自己拼
# S3_REGION=us-east-1
