# 监听端口（**不是** PORT —— 那是 nginx 的 8080）
APP_PORT=3001

# 数据层：平台选了才会注入。有值则用 SQLite，落 ${WEBGEN_DATA_DIR}/app.db
WEBGEN_DATA_DIR=

# MySQL DSN（可选，优先级高于 SQLite）。形如 mysql://user:pass@host:3306/db
DATABASE_URL=

# Redis（可选）。配了就用缓存，cache=redis
REDIS_URL=
REDIS_KEY_PREFIX=

# MinIO（可选对象存储 / 「文件系统」）。没配 S3_ENDPOINT 即优雅降级为 storage=none。
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
